rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'seogrowthers@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidNewsItem(data) {
      return data.keys().hasAll(['title', 'excerpt', 'author', 'date', 'category', 'imageUrl']) &&
             data.title is string && data.title.size() <= 200 &&
             data.excerpt is string && data.excerpt.size() <= 500 &&
             data.author is string && data.author.size() <= 100 &&
             data.date is string &&
             data.category in ['AI', 'Dev', 'Tech', 'Hardware', 'Shock'] &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             (!data.keys().contains('content') || (data.content is string && data.content.size() <= 50000));
    }

    function isValidResourceItem(data) {
      return data.keys().hasAll(['title', 'description', 'type', 'difficulty', 'tags', 'link']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.type in ['Tutorial', 'Guide', 'Documentation', 'Course'] &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.tags is list && data.tags.size() <= 10 &&
             data.link is string && data.link.size() <= 1000;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 255 &&
             data.role in ['Member', 'Premium', 'Admin'] &&
             (!data.keys().contains('avatar') || (data.avatar is string && data.avatar.size() <= 1000)) &&
             (!data.keys().contains('createdAt') || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Test Connection
    match /test/connection {
      allow read: if true;
    }

    // Collections
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Explicit separate rules
      allow get: if request.auth != null && request.auth.uid == userId;
      allow get: if isAdmin();
      allow list: if isAdmin();
      
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == 'Member';
      
      allow update: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }
  }
}
